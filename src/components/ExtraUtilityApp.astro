---
interface Props {
  tool: "jsonCsv" | "entities" | "diagram" | "qa";
}
const { tool } = Astro.props;
const examples = {
  jsonCsv: [
    "Load example: orders",
    "Two orders become two spreadsheet rows, including customer.name as a column. Review the selected record sample before converting.",
  ],
  entities: [
    "Load example: repeated names",
    "Find Ada, Lin and Acme Labs. Correct highlights in the manual mention editor.",
  ],
  diagram: [
    "Load example: approval steps",
    "Four steps form an approval flowchart with Yes and No branches. Edit connections privately; export Mermaid or SVG.",
  ],
  qa: [
    "Load example: privacy passage",
    "Expected quotation: “The application does not store submitted text or require an account.”",
  ],
};
---

<section
  data-extra-utility={tool}
  class="utility-app ph-no-capture ph-no-autocapture"
>
  <section class="panel">
    <div class="workspace-toolbar">
      <h2>Input</h2>
      <button disabled data-startup-was-enabled="true" id="extra-example">
        {examples[tool][0]}
      </button>
    </div>
    <p id="example-outcome" class="notice">
      {examples[tool][1]}
    </p>
    {tool === "qa" && (
      <>
        <input id="source-mode" type="hidden" value="paste" />
        <div role="tablist" aria-label="Source type" class="actions">
          <button
            disabled
            data-startup-was-enabled="true"
            id="paste-tab"
            role="tab"
            aria-selected="true"
            aria-controls="source-panel"
            data-source-mode="paste"
          >
            Pasted text
          </button>
          <button
            disabled
            data-startup-was-enabled="true"
            id="url-tab"
            role="tab"
            aria-selected="false"
            aria-controls="url-panel"
            tabindex="-1"
            data-source-mode="url"
          >
            Public URL
          </button>
        </div>
        <div id="url-panel" role="tabpanel" aria-labelledby="url-tab" hidden>
          <label for="page-url">Public page URL</label>
          <input
            id="page-url"
            type="text"
            inputmode="url"
            maxlength="2000"
            placeholder="modepot.io or https://example.org/page"
          />
          <p class="notice">
            Public HTTP/HTTPS pages by hostname. Bare hostnames use HTTPS.
            Logins, blocked sites, JavaScript-only pages, PDFs and large pages
            may need pasted text. UTF-8 HTML/plain text only; 250 KB and 8
            seconds.
          </p>
        </div>
      </>
    )}
    <div
      id="source-panel"
      role={tool === "qa" ? "tabpanel" : undefined}
      aria-labelledby={tool === "qa" ? "paste-tab" : undefined}
    >
      <label for="source-text">
        {tool === "jsonCsv"
          ? "JSON document"
          : tool === "diagram"
            ? "Steps (one per line)"
            : tool === "qa"
              ? "Page text"
              : "Text to explore"}
      </label>
      <textarea
        id="source-text"
        rows="7"
        maxlength={
          tool === "jsonCsv"
            ? 2000000
            : tool === "qa"
              ? 10000
              : tool === "diagram"
                ? 1800
                : 5000
        }
        placeholder={
          tool === "jsonCsv"
            ? '[{"id":"001","name":"Ada"}]'
            : tool === "diagram"
              ? "Receive request\nReview request\nSend reply"
              : tool === "qa"
                ? "Paste the source paragraphs here."
                : "Ada works at Acme Labs."
        }
      />
    </div>
    {tool === "jsonCsv" && (
      <>
        <label for="source-file">Or upload JSON (local only, up to 2 MB)</label>
        <input id="source-file" type="file" accept=".json,application/json" />
        <div id="array-options" hidden>
          <label for="row-path">Which records?</label>
          <select id="row-path" />
          <div id="record-sample-panel" hidden>
            <p class="notice">
              Preview one selected record (up to 1,000 characters)
            </p>
            <pre id="record-sample" aria-live="polite" />
          </div>
          <label for="array-policy">Nested arrays within each record</label>
          <select id="array-policy">
            <option value="reject">Stop if nested arrays exist</option>
            <option value="join">Keep as JSON text in a cell</option>
            <option value="omit">Omit nested-array fields</option>
          </select>
          <p id="nested-array-help" class="notice" aria-live="polite">
            Choose records to inspect nested arrays before conversion.
          </p>
          <p class="notice">
            Nested arrays: Stop makes no CSV; Keep as JSON text preserves
            values; Omit explicitly removes those fields. Nothing is omitted
            automatically.
          </p>
        </div>
        <details>
          <summary>Choose records with Jev</summary>
          <label for="instructions">Which records do you need?</label>
          <textarea id="instructions" rows="2" maxlength="800" />
          <p class="notice">
            Convert with Jev sends a reduced sample (five items per array) and
            your instructions to Jev/TypeSafe.
          </p>
          <button disabled data-startup-was-enabled="true" id="extra-ask">
            Convert with Jev
          </button>
        </details>
      </>
    )}
    {tool === "entities" && (
      <>
        <fieldset>
          <legend>Categories</legend>
          <label class="check">
            <input type="checkbox" id="people-category" checked />
            People
          </label>
          <label class="check">
            <input type="checkbox" id="companies-category" checked />
            Companies
          </label>
          <label class="check">
            <input type="checkbox" id="custom-category" />
            Custom
          </label>
        </fieldset>
        <div id="custom-definitions" hidden>
          <label for="instructions">
            Custom categories (Name: definition, one per line)
          </label>
          <textarea
            id="instructions"
            rows="2"
            maxlength="1000"
            placeholder="Place: a named city"
          />
        </div>
        <p class="notice">
          Extract sends text and categories to Jev/TypeSafe. Up to 120 source
          tokens and three matches per category; review highlights.
        </p>
      </>
    )}
    {tool === "entities" && (
      <details>
        <summary>Extraction limits</summary>Up to 120 source tokens and 1–4
        categories, three matches per category. This is not exhaustive
        full-document extraction.
      </details>
    )}
    {tool === "diagram" && (
      <>
        <label for="diagram-mode">Connections</label>
        <select id="diagram-mode">
          <option value="local">
            Sequential — private, edit connections yourself
          </option>
          <option value="jev">Describe connections — use Jev</option>
        </select>
        <div id="connection-description" hidden>
          <label for="instructions">Describe the connections</label>
          <textarea
            id="instructions"
            rows="3"
            maxlength="800"
            placeholder="If approved, send confirmation; otherwise notify rejection."
          />
          <p class="notice">
            Create diagram with Jev sends the listed steps and connection
            description to Jev/TypeSafe. It selects relationships, never
            arbitrary code.
          </p>
        </div>
        <p class="notice">
          Up to eight steps of 160 characters. Review labels and connections
          before export.
        </p>
      </>
    )}
    {tool === "qa" && (
      <>
        <label for="instructions">Question</label>
        <textarea
          id="instructions"
          rows="2"
          maxlength="400"
          placeholder="What does this source say about cancellation?"
        />
        <p class="notice">
          Find answer sends the source and your question to Jev/TypeSafe. URL
          mode first reads the public page. Results quote the source, not
          generated answers.
        </p>
        <p id="source-coverage" class="notice" />
        <details id="source-inspection" hidden>
          <summary>Inspect fetched source and coverage</summary>
          <pre id="fetched-source" />
        </details>
      </>
    )}
    <p class="notice">
      No saved inputs or input-content analytics.{" "}
      <a href="/privacy/">Privacy &amp; limits</a>
    </p>
    <div class="actions">
      {tool === "jsonCsv" && (
        <button
          disabled
          data-startup-was-enabled="true"
          id="extra-run"
          class="primary"
        >
          Convert
        </button>
      )}
      {tool === "entities" && (
        <button
          disabled
          data-startup-was-enabled="true"
          id="extra-ask"
          class="primary"
        >
          Extract with Jev
        </button>
      )}
      {tool === "diagram" && (
        <button
          disabled
          data-startup-was-enabled="true"
          id="create-diagram"
          class="primary"
        >
          Create diagram
        </button>
      )}
      {tool === "qa" && (
        <button
          disabled
          data-startup-was-enabled="true"
          id="extra-ask"
          class="primary"
        >
          Find answer
        </button>
      )}
    </div>
  </section>
  <p id="extra-status" class="utility-status" role="status" aria-live="polite">
    Enter your source or load an example.
  </p>
  {tool === "entities" && (
    <details id="entity-review" class="panel">
      <summary>Review or edit mentions manually</summary>
      <h2>Review mentions</h2>
      <p class="notice">
        Correct exact source text, choose its occurrence and category, or remove
        it. Offsets are computed locally.
      </p>
      <div id="entity-editor" />
      <button disabled data-startup-was-enabled="true" id="add-mention">
        Add mention manually
      </button>
      <button disabled data-startup-was-enabled="true" id="extra-run">
        Update preview
      </button>
    </details>
  )}
  {tool === "diagram" && (
    <details id="graph-panel" class="panel" hidden>
      <summary>Edit steps and connections</summary>
      <h2>Edit diagram</h2>
      <p class="notice">
        Choose each node’s type and destinations. Yes and No apply to decisions.
      </p>
      <div id="graph-editor" />
      <button disabled data-startup-was-enabled="true" id="extra-run">
        Update diagram
      </button>
      <button disabled data-startup-was-enabled="true" id="prepare-extra">
        Start a private sequential diagram
      </button>
    </details>
  )}
  {(tool === "entities" || tool === "diagram") && (
    <details>
      <summary>Advanced: import a manual JSON plan</summary>
      <label for="review-plan">Manual plan</label>
      <textarea id="review-plan" rows="4" maxlength="20000" />
      <button disabled data-startup-was-enabled="true" id="import-plan">
        Import plan
      </button>
    </details>
  )}
  <section
    id="extra-results"
    class="panel"
    tabindex="-1"
    aria-labelledby="extra-results-title"
    hidden
  >
    <h2 id="extra-results-title">Result — review before sharing</h2>
    <div id="extra-visual" />
    <details>
      <summary>Export code view</summary>
      <pre id="extra-output" />
    </details>
    <div class="actions">
      <button disabled data-startup-was-enabled="true" id="extra-download">
        Download result
      </button>
      <button disabled data-startup-was-enabled="true" id="extra-copy">
        Copy result
      </button>
    </div>
  </section>
</section>
<p id="utility-startup" class="notice" role="status" aria-live="polite">
  JavaScript is required to run tool actions. Your source stays in this browser.
</p>
<noscript>
  <p class="notice error">
    Enable JavaScript, then reload to use this tool. You can still copy any
    source text before reloading.
  </p>
</noscript>
<script is:inline>
  (() => {
    const notice = document.getElementById("utility-startup");
    notice.textContent =
      "Loading tool controls. You can paste or type source now; your text stays in this browser.";
    let ready = false;
    document.querySelectorAll(".utility-app button").forEach((button) => {
      if (!button.disabled) {
        button.dataset.startupWasEnabled = "true";
        button.disabled = true;
      }
    });
    window.addEventListener(
      "utilitypot:ready",
      () => {
        ready = true;
        notice.hidden = true;
        document
          .querySelectorAll(
            '.utility-app button[data-startup-was-enabled="true"]',
          )
          .forEach((button) => {
            button.disabled = false;
            delete button.dataset.startupWasEnabled;
          });
      },
      { once: true },
    );
    const failed = () => {
      if (ready) return;
      notice.textContent =
        "Tool controls did not finish loading. Your text is still here and can be copied. Check your connection, then reload this page to try again.";
      notice.classList.add("error");
    };
    window.addEventListener("error", (event) => {
      if (event.filename?.includes(".js")) failed();
    });
    window.addEventListener("unhandledrejection", failed);
    setTimeout(failed, 12000);
  })();
</script>
<script>
  import "../scripts/extra-utilities.js";
</script>
