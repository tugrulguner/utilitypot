---
import { guides, projects } from "../data/discovery.js";
import tools from "../data/tools.json";
interface Props {
  slug: keyof typeof guides;
}
const { slug } = Astro.props;
const guide = guides[slug];
const project = projects[guide.project as keyof typeof projects];
---

<aside
  class="tool-discovery"
  data-project-showcase
  data-discovery-surface="showcase"
  aria-label="Explore a related ModePot project"
>
  <h2>From the ModePot workshop</h2>
  <p>
    {guide.reason}{" "}
    <a
      class="ph-no-autocapture"
      href={project.href}
      data-discovery-destination={guide.project}
    >
      {project.name}
    </a>{" "}
    — {project.description}
  </p>
  <p>
    <a
      class="ph-no-autocapture"
      href="https://modepot.io/"
      data-discovery-destination="modepot"
    >
      Explore the family
    </a>{" "}
    ·{" "}
    <a
      class="ph-no-autocapture"
      href="https://tugrul.modepot.io/"
      data-discovery-destination="creator"
    >
      Meet Tugrul, the creator
    </a>
  </p>
</aside>
<section class="prose tool-guide" aria-label="How to use this tool">
  <h2>Try it, review it, reuse it</h2>
  <ol>
    {guide.steps.map((step) => (
      <li>{step}</li>
    ))}
  </ol>
  <p>
    <strong>Example:</strong> {guide.example}
  </p>
  <nav data-related-tools aria-label="Related tools">
    <h3>Useful next tools</h3>
    <ul>
      {guide.related.map((slug) => {
        const tool = tools.find((tool) => tool.slug === slug)!;
        return (
          <li>
            <a class="ph-no-autocapture" href={`/tools/${slug}/`}>
              {tool.title}
            </a>{" "}
            — {tool.description}
          </li>
        );
      })}
    </ul>
  </nav>
  <p>
    Keep this page bookmarked for your next task. Inputs are not saved for
    return visits.
  </p>
</section>
