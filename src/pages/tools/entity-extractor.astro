---
import ToolDiscovery from "../../components/ToolDiscovery.astro";
import { guides } from "../../data/discovery.js";
import UtilityLayout from "../../layouts/UtilityLayout.astro";
import ExtraUtilityApp from "../../components/ExtraUtilityApp.astro";
---

<UtilityLayout
  title="Extract names from text"
  description="Extract people, organizations, and custom categories from text. Review exact source mentions, make corrections, and export JSON."
  seoDescription={guides["entity-extractor"].description}
  searchTitle={guides["entity-extractor"].title}
  slug="entity-extractor"
>
  <ExtraUtilityApp tool="entities" />
  <ToolDiscovery slug="entity-extractor" />
  <details class="prose tool-help">
    <summary>How this tool works &amp; limits</summary>
    <h2>What this tool does</h2>
    <p>
      Extract people, organizations, and your own defined categories from the
      complete pasted source. Review exact mentions, correct labels or spans,
      and export the reviewed JSON. Source text is limited to 2 MiB; larger
      documents may take longer to process. AI results can miss names or
      misclassify them, so review the source and every result.
    </p>
    <h2>Privacy and uncertainty</h2>
    <p>
      Only explicit AI requests send bounded source context to Jev through our
      protected server. There is no account or application input-history
      database. AI classifications can be wrong; typed output is not proof of
      truth. <a href="/privacy/">Read privacy and operating limits.</a>
    </p>
  </details>
</UtilityLayout>
