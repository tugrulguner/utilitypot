---
import UtilityLayout from "../layouts/UtilityLayout.astro";
import tools from "../data/tools.json";
import CreatorSocials from "../components/CreatorSocials.astro";
---

<UtilityLayout
  title="Free browser tools for data, text and planning"
  description="Open-source browser tools for data, text, diagrams and planning. Five tools work locally; three use bounded AI after disclosed consent. Review results."
  slug=""
  overview
>
  <div class="product-hero">
    <section class="hero-copy">
      <p class="coordinate">OPEN-SOURCE UTILITIES / PART OF MODEPOT</p>
      <h1>
        Convert data.
        <br />
        Find a time.
      </h1>
      <p class="utility-intro">
        Convert CSV and JSON, clean up dates, preview cron schedules, and find a
        time across cities. Extract names, sketch a flowchart or find a passage
        in your text.
      </p>
      <p class="notice">
        No signup. Five tools work entirely in your browser; three use bounded
        AI only after you ask. Review AI-assisted results.
      </p>
      <div class="hero-actions">
        <a class="primary" href="#tools">
          Browse tools →
        </a>
        <a class="secondary" href="#how-it-works">
          How it works
        </a>
        <a href="https://github.com/tugrulguner/utilitypot">GitHub</a>
      </div>
      <div class="creator-row" data-discovery-surface="intro">
        <p class="creator-credit">
          Created by{" "}
          <a
            href="https://tugrul.modepot.io/"
            class="ph-no-autocapture"
            data-discovery-destination="creator"
          >
            Tugrul Guner
          </a>{" "}
          · Part of{" "}
          <a
            href="https://modepot.io/"
            class="ph-no-autocapture"
            data-discovery-destination="modepot"
          >
            ModePot
          </a>
        </p>
        <CreatorSocials />
      </div>
    </section>
    <img
      class="product-art"
      src="/utilitypot-lockup-v2.png?v=family-attribution-3"
      alt="UtilityPot — Focused browser tools for data, text, diagrams and planning."
      width="1200"
      height="900"
      fetchpriority="high"
    />
  </div>
  <section id="tools" class="tools-section">
    <p class="coordinate">CHOOSE A TASK</p>
    <h2>Eight tools. No signup.</h2>
    <div class="tool-cards">
      {tools.map(({ slug, title, description, processing }) => (
        <article class="panel">
          <h3>{title}</h3>
          <p class="coordinate tool-processing">{processing}</p>
          <p class="notice">{description}</p>
          <a
            class="tool-link"
            aria-label={`Open ${title}`}
            href={`/tools/${slug}/`}
          >
            Open {title} →
          </a>
        </article>
      ))}
    </div>
  </section>
  <section id="how-it-works" class="prose">
    <p class="coordinate">HOW THE TOOLS WORK</p>
    <h2>Add your input. Preview the result.</h2>
    <p>
      Choose a task, paste your data or upload a supported file, and use the
      main action. Check the result, adjust anything unclear, then copy or
      download it.
    </p>
    <ol class="mechanism-steps">
      <li>
        <strong>Add your input.</strong> Each tool explains the formats and
        limits it supports.
      </li>
      <li>
        <strong>Check the preview.</strong> See what changed and correct unclear
        choices.
      </li>
      <li>
        <strong>Copy or download.</strong> Take the result into your
        spreadsheet, calendar or document.
      </li>
    </ol>
    <p>
      CSV/JSON conversion, date cleanup and scheduling stay in your browser.
      Entity extraction, interpreting flowchart connections and selecting source
      passages use Jev by TypeSafe; their action buttons explain what is sent.
      Review AI results: names can be missed or mislabelled, diagrams are
      limited to eight steps, and webpage answers quote the source rather than
      generate essays.
    </p>
    <p>
      No account or saved input history. Submitted AI context is processed by
      TypeSafe. <a href="/privacy/">Read privacy and operating limits</a> or{" "}
      <a href="https://github.com/tugrulguner/utilitypot#local-setup">
        run UtilityPot locally
      </a>
      .
    </p>
  </section>
</UtilityLayout>
