---
import FamilyDiscovery from "./FamilyDiscovery.astro";
interface Props {
  tool: "csv" | "dates" | "meeting";
}
const { tool } = Astro.props;
const examples = {
  csv: [
    "Load example: customers",
    "Example: three rows → two customer groups: 001 has two items, 002 has one.",
  ],
  dates: [
    "Load example: mixed dates",
    "Example: complete, unclear, invalid and month/year-only dates. Every original stays in the report.",
  ],
  meeting: [
    "Load example: working hours",
    "Sample London–Kolkata hours, not your availability. Find 30-minute overlaps.",
  ],
};
import { meetingCities } from "../lib/utilities/meeting-presentation.js";
---

<section
  data-utility={tool}
  class="utility-app ph-no-capture ph-no-autocapture"
  data-processing="local"
>
  <section class="panel">
    <header class="workspace-header workspace-toolbar">
      <div>
        <p class="workspace-kicker" hidden={tool === "meeting"}>
          {tool === "csv"
            ? "CSV rows"
            : tool === "dates"
              ? "Date text"
              : "Availability"}
        </p>
        <h2>
          {tool === "csv"
            ? "Add your data"
            : tool === "dates"
              ? "Clean up your date list"
              : "Where is everyone?"}
        </h2>
      </div>
      {tool !== "meeting" && (
        <button disabled data-startup-was-enabled="true" id="load-example">
          {examples[tool][0]}
        </button>
      )}
    </header>
    <p
      id="example-outcome"
      class="workspace-description notice"
      hidden={tool === "meeting"}
    >
      {examples[tool][1]}
    </p>
    {tool === "csv" && (
      <>
        <div class="input-surface">
          <label for="csv-input">Paste your CSV rows</label>
          <textarea
            id="csv-input"
            rows="7"
            maxlength="2000000"
            placeholder="Customer,Name,SKU,Qty&#10;001,Ada,A01,2"
          />
          <label for="source-file">
            CSV file (≤2 MB; 20 columns / 10,000 rows)
          </label>
          <input id="source-file" type="file" accept=".csv,text/csv" />
        </div>
        <label for="group-by">Group rows by</label>
        <select id="group-by">
          <option value="">Paste CSV to choose a field</option>
        </select>
        <p class="notice">
          Group by a parent key. Other columns become child rows; values stay
          text.
        </p>
      </>
    )}
    {tool === "dates" && (
      <>
        <div class="input-surface">
          <label for="dates-input">Paste dates, one per line</label>
          <textarea
            id="dates-input"
            rows="7"
            maxlength="200000"
            placeholder="25/03/2026&#10;03/04/2026&#10;2026-02"
          />
        </div>
        <p class="input-meta notice">
          Original values stay in the report. Ambiguous, partial and invalid
          dates remain visible. Month-only formats: January 2027, Jan 2027,
          01/2027 (MM/YYYY), or 2027-01. Year-only: 2027. No day is invented.
        </p>
        <div id="convention-panel" hidden>
          <p id="date-convention-scope" class="notice">
            Your choice applies to all numeric day/month/year dates in this
            list. ISO dates and named months are unchanged. Mixed sources? Keep
            Unknown and review them separately.
          </p>
          <label for="date-convention">
            How should numeric dates in this list be read?
          </label>
          <select id="date-convention">
            <option value="auto">Unknown — keep ambiguity visible</option>
            <option value="day-first">Day first: 03/04 means 3 April</option>
            <option value="month-first">
              Month first: 03/04 means March 4
            </option>
          </select>
        </div>
      </>
    )}
    {tool === "meeting" && (
      <>
        <div class="utility-grid meeting-settings">
          <div>
            <label for="meeting-date">Local date</label>
            <input id="meeting-date" type="date" />
          </div>
          <div>
            <label for="duration">Duration (min)</label>
            <input id="duration" type="number" min="15" max="240" value="30" />
          </div>
        </div>
        <div id="participants">
          {[0, 1].map((i) => (
            <div class="participant panel" data-index={i}>
              <h2>Person {i + 1}</h2>
              <div class="participant-place-row">
                <div class="participant-place">
                  <label for={`p${i}-zone`}>City or timezone</label>
                  <input
                    id={`p${i}-zone`}
                    data-field="zone"
                    list="zones"
                    maxlength="80"
                    placeholder="Search a city, e.g. London"
                  />
                </div>
              </div>
              <details class="participant-hours" data-availability="local">
                <summary>
                  <span data-hours-summary>09:00–17:00 local time</span>
                  <span class="hours-edit">Change hours</span>
                </summary>
                <div class="utility-grid">
                  {["start", "end"].map((f, j) => (
                    <div>
                      <label for={`p${i}-${f}`}>
                        {j === 0 ? "Available from" : "Available until"} {i + 1}
                      </label>
                      <input
                        id={`p${i}-${f}`}
                        data-field={f}
                        type="time"
                        value={j === 0 ? "09:00" : "17:00"}
                      />
                    </div>
                  ))}
                </div>
                <label for={`p${i}-name`}>Name (optional)</label>
                <input id={`p${i}-name`} data-field="name" maxlength="60" />
                <details>
                  <summary>Add a break or unavailable time</summary>
                  <div class="utility-grid">
                    {["excludeStart", "excludeEnd"].map((f, j) => (
                      <div>
                        <label for={`p${i}-${f}`}>
                          {j === 0 ? "Exclude from" : "Exclude until"} {i + 1}
                        </label>
                        <input id={`p${i}-${f}`} data-field={f} type="time" />
                      </div>
                    ))}
                  </div>
                </details>
                <p class="notice">
                  Hours use this person's local date. Overnight hours finish the
                  next day.
                </p>
              </details>
            </div>
          ))}
        </div>

        <datalist id="zones">
          {meetingCities.map(({ value, zone }) => (
            <option value={value}>
              {value} · {zone}
            </option>
          ))}
        </datalist>
        <p class="notice">
          Compare 09:00–17:00 local hours, or change them to fit your
          availability.
        </p>
      </>
    )}
    <div class="actions">
      <button disabled data-startup-was-enabled="true" id="run" class="primary">
        {tool === "csv"
          ? "Create nested JSON"
          : tool === "dates"
            ? "Fix dates"
            : "Find times"}
      </button>
    </div>
    {tool === "csv" && (
      <>
        {" "}
        <details>
          <summary>Output structure and custom field mapping</summary>
          <label for="child-name">Child array name</label>
          <input id="child-name" value="rows" maxlength="80" />
          <div id="parent-fields" />
          <label class="check">
            <input id="custom-schema" type="checkbox" />
            Use a custom output schema
          </label>
          <label for="json-example">Custom JSON example (one parent)</label>
          <textarea
            id="json-example"
            rows="4"
            maxlength="4000"
            placeholder={'{"id":"001","items":[{"sku":"A01"}]}'}
          />
          <button id="prepare" disabled data-startup-was-enabled="true">
            Set field mapping
          </button>
        </details>
        <div id="mapping-panel" hidden>
          <h3>Editable column mapping</h3>
          <div id="mapping-fields" />
        </div>
      </>
    )}
    {tool === "meeting" && (
      <>
        <div class="actions meeting-secondary-actions">
          <button disabled data-startup-was-enabled="true" id="load-example">
            {examples[tool][0]}
          </button>
          <button disabled data-startup-was-enabled="true" id="add-person">
            Add person
          </button>
          <button disabled data-startup-was-enabled="true" id="remove-person">
            Remove last
          </button>
        </div>
        <details>
          <summary>Supported cities and timezones</summary>
          <p class="notice">
            Search this local list, then enter a city above. Only listed cities
            and valid IANA timezones are supported. For ambiguous names,
            identify the state or country and choose its known timezone.
          </p>
          <label for="city-search">Search supported cities or aliases</label>
          <input id="city-search" type="search" maxlength="80" />
          <ul id="city-matches" aria-live="polite">
            {meetingCities.map(({ value, zone }) => (
              <li>
                {value} · {zone}
              </li>
            ))}
          </ul>
        </details>
      </>
    )}
  </section>
  <p
    id="utility-status"
    class="utility-status"
    role="status"
    aria-live="polite"
  >
    Paste your source or load an example. Local actions stay in your browser.
  </p>
  <section
    id="results"
    class="panel"
    tabindex="-1"
    aria-labelledby="results-title"
    hidden
  >
    <header class="result-toolbar">
      <h2 id="results-title">
        {tool === "csv"
          ? "Nested records"
          : tool === "dates"
            ? "Date review"
            : "Available meeting times"}
      </h2>
      <div class="actions">
        <button disabled data-startup-was-enabled="true" id="download">
          Download result
        </button>
        <button disabled data-startup-was-enabled="true" id="copy">
          Copy result
        </button>
      </div>
    </header>
    <div id="result-view" class="result-inspector" />
    <FamilyDiscovery surface="result" />
  </section>
</section>
<p id="utility-startup" class="notice" role="status" aria-live="polite">
  JavaScript is required to run tool actions. Your source stays in this browser.
</p>
<noscript>
  <p class="notice error">
    Enable JavaScript, then reload to use this tool. You can still copy any
    source text before reloading.
  </p>
</noscript>
<script is:inline>
  (() => {
    const notice = document.getElementById("utility-startup");
    notice.textContent =
      "Loading tool controls. You can paste or type source now; your text stays in this browser.";
    let ready = false;
    document.querySelectorAll(".utility-app button").forEach((button) => {
      if (!button.disabled) {
        button.dataset.startupWasEnabled = "true";
        button.disabled = true;
      }
    });
    window.addEventListener(
      "utilitypot:ready",
      () => {
        ready = true;
        notice.hidden = true;
        document
          .querySelectorAll(
            '.utility-app button[data-startup-was-enabled="true"]',
          )
          .forEach((button) => {
            button.disabled = false;
            delete button.dataset.startupWasEnabled;
          });
      },
      { once: true },
    );
    const failed = () => {
      if (ready) return;
      notice.textContent =
        "Tool controls did not finish loading. Your text is still here and can be copied. Check your connection, then reload this page to try again.";
      notice.classList.add("error");
    };
    window.addEventListener("error", (event) => {
      if (event.filename?.includes(".js")) failed();
    });
    window.addEventListener("unhandledrejection", failed);
    setTimeout(failed, 12000);
  })();
</script>
<script>
  import "../scripts/utilities.js";
</script>
