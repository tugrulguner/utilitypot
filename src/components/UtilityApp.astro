---
interface Props {
  tool: "csv" | "dates" | "meeting";
}
const { tool } = Astro.props;
const examples = {
  csv: [
    "Load example: customers",
    "Three rows → two customer groups: 001 has two items, 002 has one.",
  ],
  dates: [
    "Load example: mixed dates",
    "Try complete, unclear, invalid and month/year-only dates. Every original stays in the report.",
  ],
  meeting: [
    "Load example: working hours",
    "Sample London–Kolkata hours, not your availability. Find 30-minute overlaps.",
  ],
};
import { meetingCities } from "../lib/utilities/meeting-presentation.js";
---

<section
  data-utility={tool}
  class="utility-app ph-no-capture ph-no-autocapture"
>
  <section class="panel">
    <div class="workspace-toolbar">
      <h2>Input</h2>
      <button id="load-example">{examples[tool][0]}</button>
    </div>
    <p id="example-outcome" class="notice">
      {examples[tool][1]}
    </p>
    {tool === "csv" && (
      <>
        <label for="csv-input">CSV data</label>
        <textarea
          id="csv-input"
          rows="7"
          maxlength="2000000"
          placeholder="Customer,Name,SKU,Qty&#10;001,Ada,A01,2"
        />
        <label for="source-file">Or upload CSV (local only, up to 2 MB)</label>
        <input id="source-file" type="file" accept=".csv,text/csv" />
        <label for="group-by">Group rows by</label>
        <select id="group-by">
          <option value="">Paste CSV to choose a field</option>
        </select>
        <p class="notice">
          Rows with the same value in this column form one group. Every value
          stays a string. Other columns become child rows with their original
          header names. Up to 20 columns and 10,000 rows.
        </p>
        <details>
          <summary>Advanced structure and custom mapping</summary>
          <label for="child-name">Child array name</label>
          <input id="child-name" value="rows" maxlength="80" />
          <div id="parent-fields" />
          <label class="check">
            <input id="custom-schema" type="checkbox" />
            Use a custom output schema
          </label>
          <label for="json-example">Custom JSON example (one parent)</label>
          <textarea
            id="json-example"
            rows="4"
            maxlength="4000"
            placeholder={'{"id":"001","items":[{"sku":"A01"}]}'}
          />
          <label for="csv-intent">Mapping instructions</label>
          <input id="csv-intent" maxlength="800" />
          <button id="prepare">Prepare manual mapping</button>
          <p class="notice">
            Create with Jev sends headers, five sample rows, this schema and
            instructions to Jev/TypeSafe. Review proposed mappings; unknown
            fields stop conversion.
          </p>
          <button id="ask-jev">Create with Jev</button>
        </details>
        <div id="mapping-panel" hidden>
          <h3>Editable column mapping</h3>
          <div id="mapping-fields" />
        </div>
      </>
    )}
    {tool === "dates" && (
      <>
        <label for="dates-input">Dates (one per line)</label>
        <textarea
          id="dates-input"
          rows="7"
          maxlength="200000"
          placeholder="25/03/2026&#10;03/04/2026&#10;2026-02"
        />
        <p class="notice">
          Original values stay in the report. Ambiguous, partial and invalid
          dates remain visible. Month-only formats: January 2027, Jan 2027,
          01/2027 (MM/YYYY), or 2027-01. Year-only: 2027. No day is invented.
        </p>
        <div id="convention-panel" hidden>
          <p id="date-convention-scope" class="notice">
            Your choice applies to all numeric day/month/year dates in this
            list. ISO dates and named months are unchanged. Mixed sources? Keep
            Unknown and review them separately.
          </p>
          <label for="date-convention">
            How should numeric dates in this list be read?
          </label>
          <select id="date-convention">
            <option value="auto">Unknown — keep ambiguity visible</option>
            <option value="day-first">Day first: 03/04 means 3 April</option>
            <option value="month-first">
              Month first: 03/04 means March 4
            </option>
          </select>
        </div>
        <details>
          <summary>Interpret source context with Jev</summary>
          <label for="date-context">What do you know about the source?</label>
          <textarea
            id="date-context"
            rows="2"
            maxlength="1000"
            placeholder="This export is from our UK office."
          />
          <p class="notice">
            Fix with Jev sends up to 20 dates and this context to Jev/TypeSafe.
            The proposed convention stays editable; unresolved dates are never
            guessed.
          </p>
          <button id="ask-jev">Fix with Jev</button>
        </details>
      </>
    )}
    {tool === "meeting" && (
      <>
        <div class="utility-grid">
          <div>
            <label for="meeting-date">Local date</label>
            <input id="meeting-date" type="date" />
          </div>
          <div>
            <label for="duration">Minutes</label>
            <input id="duration" type="number" min="15" max="240" value="30" />
          </div>
        </div>
        <label for="availability-mode">Availability</label>
        <select id="availability-mode">
          <option value="local">Enter local times — private</option>
          <option value="jev">Describe times — use Jev</option>
        </select>
        <p id="meeting-consent" class="notice" hidden>
          Find times with Jev sends the date, duration, participant labels,
          zones and statements to Jev/TypeSafe. Review the proposed windows and
          slots before export.
        </p>
        <div id="participants">
          {[0, 1].map((i) => (
            <div class="participant panel" data-index={i}>
              <h2>Participant {i + 1}</h2>
              <div class="utility-grid">
                <div>
                  <label for={`p${i}-zone`}>City / timezone {i + 1}</label>
                  <input
                    id={`p${i}-zone`}
                    data-field="zone"
                    list="zones"
                    maxlength="80"
                    placeholder="Search a city, e.g. London"
                  />
                </div>
                <details class="participant-name">
                  <summary>Name (optional)</summary>
                  <label for={`p${i}-name`}>Name for participant {i + 1}</label>
                  <input id={`p${i}-name`} data-field="name" maxlength="60" />
                </details>
              </div>
              <div data-availability="jev" hidden>
                <label for={`p${i}-text`}>Availability statement {i + 1}</label>
                <textarea
                  id={`p${i}-text`}
                  data-field="text"
                  rows="2"
                  maxlength="500"
                  placeholder="From 9am until 5pm, except noon to 1pm."
                />
              </div>
              <div data-availability="local">
                <div class="utility-grid">
                  {["start", "end"].map((f, j) => (
                    <div>
                      <label for={`p${i}-${f}`}>
                        {j === 0 ? "Available from" : "Available until"} {i + 1}
                      </label>
                      <input id={`p${i}-${f}`} data-field={f} type="time" />
                    </div>
                  ))}
                </div>
                <details>
                  <summary>Excluded interval</summary>
                  <div class="utility-grid">
                    {["excludeStart", "excludeEnd"].map((f, j) => (
                      <div>
                        <label for={`p${i}-${f}`}>
                          {j === 0 ? "Exclude from" : "Exclude until"} {i + 1}
                        </label>
                        <input id={`p${i}-${f}`} data-field={f} type="time" />
                      </div>
                    ))}
                  </div>
                </details>
              </div>
            </div>
          ))}
        </div>

        <datalist id="zones">
          {meetingCities.map(({ value, zone }) => (
            <option value={value}>
              {value} · {zone}
            </option>
          ))}
        </datalist>
        <p class="notice">
          For this date only. Overnight windows finish the next day.
        </p>
      </>
    )}
    <div class="actions">
      <button id="run" class="primary">
        {tool === "csv"
          ? "Create nested JSON"
          : tool === "dates"
            ? "Fix dates"
            : "Find times"}
      </button>
    </div>
    {tool === "meeting" && (
      <>
        <div class="actions meeting-secondary-actions">
          <button id="add-person">Add participant</button>
          <button id="remove-person">Remove last</button>
        </div>
        <details>
          <summary>Supported cities and timezones</summary>
          <p class="notice">
            Search this local list, then enter a city above. Only listed cities
            and valid IANA timezones are supported. For ambiguous names,
            identify the state or country and choose its known timezone.
          </p>
          <label for="city-search">Search supported cities or aliases</label>
          <input id="city-search" type="search" maxlength="80" />
          <ul id="city-matches" aria-live="polite">
            {meetingCities.map(({ value, zone }) => (
              <li>
                {value} · {zone}
              </li>
            ))}
          </ul>
        </details>
      </>
    )}
  </section>
  <p
    id="utility-status"
    class="utility-status"
    role="status"
    aria-live="polite"
  >
    Paste your source or load an example. Local actions stay in your browser.
  </p>
  <section id="results" class="panel" hidden>
    <h2>Result</h2>
    <div id="result-view" />
    <div class="actions">
      <button id="download">Download result</button>
      <button id="copy">Copy result</button>
    </div>
  </section>
</section>
<p id="utility-startup" class="notice" role="status" aria-live="polite">
  Loading tool controls. You can paste or type source now; your text stays in
  this browser.
</p>
<script is:inline>
  (() => {
    const notice = document.getElementById("utility-startup");
    let ready = false;
    document.querySelectorAll(".utility-app button").forEach((button) => {
      if (!button.disabled) {
        button.dataset.startupWasEnabled = "true";
        button.disabled = true;
      }
    });
    window.addEventListener(
      "utilitypot:ready",
      () => {
        ready = true;
        notice.hidden = true;
        document
          .querySelectorAll(
            '.utility-app button[data-startup-was-enabled="true"]',
          )
          .forEach((button) => {
            button.disabled = false;
            delete button.dataset.startupWasEnabled;
          });
      },
      { once: true },
    );
    const failed = () => {
      if (ready) return;
      notice.textContent =
        "Tool controls did not finish loading. Your text is still here and can be copied. Check your connection, then reload this page to try again.";
      notice.classList.add("error");
    };
    window.addEventListener("error", (event) => {
      if (event.filename?.includes(".js")) failed();
    });
    window.addEventListener("unhandledrejection", failed);
    setTimeout(failed, 12000);
  })();
</script>
<script>
  import "../scripts/utilities.js";
</script>
