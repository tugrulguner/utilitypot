---
import ToolDiscovery from "../../components/ToolDiscovery.astro";
import { guides } from "../../data/discovery.js";
import UtilityLayout from "../../layouts/UtilityLayout.astro";
import ExtraUtilityApp from "../../components/ExtraUtilityApp.astro";
---

<UtilityLayout
  title="JSON to CSV"
  description="Turn JSON records into a spreadsheet-ready CSV."
  seoDescription={guides["json-to-csv"].description}
  searchTitle={guides["json-to-csv"].title}
  slug="json-to-csv"
>
  <ExtraUtilityApp tool="jsonCsv" />
  <ToolDiscovery slug="json-to-csv" />
  <details class="prose tool-help">
    <summary>How this tool works &amp; limits</summary>
    <h2>What this tool does</h2>
    <p>
      Select the record array before exporting. Nested objects become
      dot-separated columns. Other arrays must be explicitly rejected, omitted,
      or stored in one JSON-text cell. This version does not explode nested
      arrays or join parent context automatically. Formula-like cells are
      escaped before spreadsheet import.
    </p>
    <h2>Privacy and uncertainty</h2>
    <p>
      Conversion runs entirely in your browser, without AI or uploading your
      JSON. Choose the source records and nested-array policy explicitly;
      nothing is silently omitted. There is no account or application
      input-history database.{" "}
      <a href="/privacy/">Read privacy and operating limits.</a>
    </p>
  </details>
</UtilityLayout>
