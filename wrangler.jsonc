{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "utilitypot-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "ratelimits": [
    {
      "name": "UTILITY_RATE_LIMIT",
      "namespace_id": "3001",
      "simple": {
        "limit": 6,
        "period": 60,
      },
    },
    {
      "name": "UTILITY_GLOBAL_RATE_LIMIT",
      "namespace_id": "3002",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
}
