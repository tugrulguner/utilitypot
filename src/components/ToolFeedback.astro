---
import tools from "../data/tools.json";
interface Props {
  tool: string;
  context: "result" | "error";
  id?: string;
}
const { tool, context, id } = Astro.props;
const entry = tools.find((entry) => entry.tool === tool);
if (!entry) throw new Error("Unknown tool feedback context");
const canonical = `https://utilitypot.modepot.io/tools/${entry.slug}/`;
const href = `https://github.com/tugrulguner/utilitypot/issues/new?title=${encodeURIComponent(`[${entry.title}] Feedback`)}&body=${encodeURIComponent(`Tool: ${entry.title}\nPage: ${canonical}\n\nDescribe what went wrong. Please avoid including private inputs, source text, questions or results.`)}`;
---

<a
  id={id}
  data-tool-feedback={context}
  class:list={[
    "tool-feedback-link",
    "ph-no-autocapture",
    { "tool-feedback-error": context === "error" },
  ]}
  href={href}
  hidden={context === "error"}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={
    context === "result"
      ? `Report an issue with this result for ${entry.title} (opens GitHub in a new tab)`
      : `Report this problem with ${entry.title} (opens GitHub in a new tab)`
  }
>
  {context === "result" ? "Report an issue" : "Report this problem"}{" "}
  <span aria-hidden="true">↗</span>
</a>
