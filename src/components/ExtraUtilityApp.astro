---
import FamilyDiscovery from "./FamilyDiscovery.astro";
interface Props {
  tool: "jsonCsv" | "entities" | "diagram" | "qa";
}
const { tool } = Astro.props;
const readerIssueUrl = `https://github.com/tugrulguner/utilitypot/issues/new?title=${encodeURIComponent("[Ask a page or text] Problem report")}&body=${encodeURIComponent("Tool: Ask a page or text\nPage: https://utilitypot.modepot.io/tools/ask-a-webpage/\n\nDescribe what went wrong. Please avoid including private source text or questions.")}`;
const examples = {
  jsonCsv: [
    "Load example: orders",
    "Two orders become two spreadsheet rows, including customer.name as a column. Review the sample rows before converting.",
  ],
  entities: [
    "Load example: repeated names",
    "Extract names from the sample source, then review exact source mentions.",
  ],
  diagram: [
    "Load example: approval steps",
    "Four supplied steps become an inspectable approval flowchart after Jev proposes connections.",
  ],
  qa: [
    "Load example: privacy question",
    "See how a source-backed answer brings together relevant facts and conditions.",
  ],
};
---

<section
  data-extra-utility={tool}
  data-processing={tool === "jsonCsv" ? "local" : "ai"}
  class="utility-app ph-no-capture ph-no-autocapture"
>
  <section class="panel">
    <div class="workspace-header">
      <div>
        <p class="workspace-kicker">
          {tool === "jsonCsv"
            ? "JSON data"
            : tool === "entities"
              ? "Text & categories"
              : tool === "diagram"
                ? "Steps & connections"
                : "Source & question"}
        </p>
        <h2>
          {tool === "jsonCsv"
            ? "Make spreadsheet rows from your JSON"
            : tool === "entities"
              ? "Explore names in context"
              : tool === "diagram"
                ? "Describe the flow"
                : "Ask your source"}
        </h2>
      </div>
      <button disabled data-startup-was-enabled="true" id="extra-example">
        {examples[tool][0]}
      </button>
    </div>
    <p id="example-outcome" class="workspace-description notice">
      {examples[tool][1]}
    </p>
    {tool === "qa" && (
      <>
        <input id="source-mode" type="hidden" value="paste" />
        <div role="tablist" aria-label="Source type" class="actions">
          <button
            disabled
            data-startup-was-enabled="true"
            id="paste-tab"
            role="tab"
            aria-selected="true"
            aria-controls="source-panel"
            data-source-mode="paste"
          >
            Pasted text
          </button>
          <button
            disabled
            data-startup-was-enabled="true"
            id="url-tab"
            role="tab"
            aria-selected="false"
            aria-controls="url-panel"
            tabindex="-1"
            data-source-mode="url"
          >
            Public URL
          </button>
        </div>
        <div id="url-panel" role="tabpanel" aria-labelledby="url-tab" hidden>
          <label for="page-url">Public page URL</label>
          <input
            id="page-url"
            type="text"
            inputmode="url"
            maxlength="2000"
            placeholder="modepot.io or https://example.org/page"
          />
          <p class="notice">
            Public HTTP/HTTPS pages by hostname. Bare hostnames use HTTPS.
            Logins, blocked sites, JavaScript-only pages, PDFs and large pages
            may need pasted text. UTF-8 HTML/plain text only; 250 KB and 8
            seconds.
          </p>
        </div>
      </>
    )}
    <div
      id="source-panel"
      role={tool === "qa" ? "tabpanel" : undefined}
      aria-labelledby={tool === "qa" ? "paste-tab" : undefined}
    >
      <label for="source-text">
        {tool === "jsonCsv"
          ? "JSON document"
          : tool === "diagram"
            ? "Steps (one per line)"
            : tool === "qa"
              ? "Page text"
              : "Text to explore"}
      </label>
      <textarea
        id="source-text"
        class={
          tool === "jsonCsv" ? "input-surface" : "input-surface prose-input"
        }
        rows={tool === "qa" ? 5 : 7}
        maxlength={
          tool === "jsonCsv"
            ? 2000000
            : tool === "qa"
              ? 2097152
              : tool === "diagram"
                ? 1800
                : 2097152
        }
        placeholder={
          tool === "jsonCsv"
            ? '[{"id":"001","name":"Ada"}]'
            : tool === "diagram"
              ? "Receive request\nReview request\nSend reply"
              : tool === "qa"
                ? "Paste an article, document, notes or other source text."
                : "Ada works at Acme Labs."
        }
      />
    </div>
    {tool === "jsonCsv" && (
      <>
        <label for="source-file">Or upload JSON (local only, up to 2 MB)</label>
        <input id="source-file" type="file" accept=".json,application/json" />
        <div id="array-options" hidden>
          <div id="row-choice-control" class="row-choice-control">
            <label for="row-path">
              Which list should become spreadsheet rows?
            </label>
            <p class="notice">
              Each item in the selected list becomes a separate row. Choose
              using the list name, row count and fields.
            </p>
            <select id="row-path" />
          </div>
          <p id="row-summary" class="row-summary" aria-live="polite" />
          <div id="record-sample-panel" hidden>
            <p class="notice">
              Sample from your JSON — up to two rows and four fields
            </p>
            <div
              id="record-sample"
              class="table-scroll"
              tabindex="0"
              aria-label="Sample rows from your JSON"
            />
          </div>
          <div id="nested-list-options">
            <label for="array-policy">If a row contains another list</label>
            <select id="array-policy">
              <option value="reject">Stop if nested arrays exist</option>
              <option value="join">Keep as JSON text in a cell</option>
              <option value="omit">Omit nested-array fields</option>
            </select>
            <p id="nested-array-help" class="notice" aria-live="polite">
              Choose a list above to inspect its data before conversion.
            </p>
            <p class="notice">
              Stop leaves your source unchanged. Keep stores the whole nested
              list in one cell. Omit leaves those fields out; nothing is removed
              automatically.
            </p>
          </div>
        </div>
      </>
    )}
    {tool === "entities" && (
      <>
        <fieldset>
          <legend>Categories</legend>
          <label class="check">
            <input type="checkbox" id="people-category" checked />
            People
          </label>
          <label class="check">
            <input type="checkbox" id="companies-category" checked />
            Companies
          </label>
          <label class="check">
            <input type="checkbox" id="custom-category" />
            Custom
          </label>
        </fieldset>
        <div id="custom-definitions" hidden>
          <label for="instructions">
            Custom categories (Name: definition, one per line)
          </label>
          <textarea
            id="instructions"
            rows="2"
            maxlength="1000"
            placeholder="Place: a named city"
          />
        </div>
        <p id="processing-disclosure" class="notice">
          Extract names from text sends the source text and selected categories
          to Jev/TypeSafe. Review exact source mentions before exporting.
        </p>
      </>
    )}
    {tool === "diagram" && (
      <>
        <div id="connection-description">
          <label for="instructions">Describe the connections</label>
          <textarea
            id="instructions"
            rows="3"
            maxlength="800"
            placeholder="If approved, send confirmation; otherwise notify rejection."
          />
          <p id="processing-disclosure" class="notice">
            Selecting Create flowchart sends the listed steps and connection
            description to Jev/TypeSafe. It selects relationships, never
            arbitrary code.
          </p>
        </div>
        <p class="notice">
          Up to eight steps of 160 characters. Review labels and connections
          before export.
        </p>
      </>
    )}
    {tool === "qa" && (
      <>
        <label for="instructions">Question</label>
        <textarea
          id="instructions"
          rows="2"
          maxlength="1000"
          placeholder="What does this source say about cancellation?"
        />
        <p id="processing-disclosure" class="notice">
          Find answer sends source + question to Jev/TypeSafe; no prose is
          generated. URL mode reads the public page first.
        </p>
        <p id="source-coverage" class="notice" />
        <details id="source-inspection" hidden>
          <summary>Inspect fetched source and coverage</summary>
          <pre id="fetched-source" />
        </details>
      </>
    )}
    <div class="actions">
      {tool === "jsonCsv" && (
        <button
          disabled
          data-startup-was-enabled="true"
          id="extra-run"
          class="primary"
        >
          Convert
        </button>
      )}
      {tool === "entities" && (
        <button
          disabled
          data-startup-was-enabled="true"
          id="extra-ask"
          aria-describedby="processing-disclosure"
          class="primary"
        >
          Extract names
        </button>
      )}
      {tool === "diagram" && (
        <button
          disabled
          data-startup-was-enabled="true"
          id="create-diagram"
          aria-describedby="processing-disclosure"
          class="primary"
        >
          Create flowchart
        </button>
      )}
      {tool === "qa" && (
        <button
          disabled
          data-startup-was-enabled="true"
          id="extra-ask"
          aria-describedby="processing-disclosure"
          class="primary"
        >
          Find answer
        </button>
      )}
    </div>
    {tool === "entities" && (
      <details>
        <summary>Extraction limits</summary>Up to four categories and 2 MiB of
        UTF-8 text. Documents run in sections; long documents take time.
        Capacity limits stop processing without accepting a partial result. AI
        can miss or mislabel names; review the source before exporting.
      </details>
    )}
    <p class="notice">
      No saved inputs or input-content analytics.{" "}
      <a href="/privacy/">Privacy &amp; limits</a>
    </p>
  </section>
  <p id="extra-status" class="utility-status" role="status" aria-live="polite">
    Enter your source or load an example.
  </p>
  {tool === "qa" && (
    <a
      id="extra-report-problem"
      class="utility-report-problem ph-no-autocapture"
      data-ph-no-autocapture="true"
      hidden
      target="_blank"
      rel="noopener noreferrer"
      href={readerIssueUrl}
    >
      Report this problem
    </a>
  )}
  {tool === "entities" && (
    <details id="entity-review" class="panel" hidden>
      <summary>Correct accepted mentions</summary>
      <h2>Inspect and correct accepted mentions</h2>
      <p class="notice">
        Correct exact source text, choose its occurrence and category, or remove
        it. Offsets are computed locally.
      </p>
      <div id="entity-editor" />
      <button disabled data-startup-was-enabled="true" id="extra-run">
        Update preview
      </button>
    </details>
  )}
  {tool === "diagram" && (
    <details id="graph-panel" class="panel" hidden>
      <summary>Correct accepted steps and connections</summary>
      <h2>Edit diagram</h2>
      <p class="notice">
        Choose each node’s type and destinations. Yes and No apply to decisions.
      </p>
      <div id="graph-editor" />
      <button disabled data-startup-was-enabled="true" id="extra-run">
        Update diagram
      </button>
    </details>
  )}

  <section
    id="extra-results"
    class:list={["panel", { "reader-result": tool === "qa" }]}
    tabindex="-1"
    aria-labelledby="extra-results-title"
    hidden
  >
    {tool === "qa" && (
      <h2 id="extra-results-title" class="reader-answer-heading">
        Answer
      </h2>
    )}
    {tool !== "qa" && (
      <header class="result-toolbar">
        <h2 id="extra-results-title">
          {tool === "jsonCsv"
            ? "Spreadsheet preview"
            : tool === "entities"
              ? "Named entities in context"
              : tool === "diagram"
                ? "Your flowchart"
                : "Answer"}
        </h2>
        <div class="actions">
          <button disabled data-startup-was-enabled="true" id="extra-download">
            Download result
          </button>
          <button disabled data-startup-was-enabled="true" id="extra-copy">
            Copy result
          </button>
        </div>
      </header>
    )}
    <div id="extra-visual" class="result-inspector" />
    {tool === "qa" && (
      <div
        class="reader-result-toolbar"
        role="group"
        aria-label="Use this answer"
      >
        <button disabled data-startup-was-enabled="true" id="extra-copy">
          Copy answer
        </button>
        <button disabled data-startup-was-enabled="true" id="extra-download">
          Download answer
        </button>
      </div>
    )}
    <details>
      <summary>
        {tool === "qa" ? "Answer Markdown" : "Export code view"}
      </summary>
      <pre id="extra-output" />
    </details>
    <FamilyDiscovery surface="result" />
  </section>
</section>
<p id="utility-startup" class="notice" role="status" aria-live="polite">
  JavaScript is required to run tool actions. Your source stays in this browser.
</p>
<noscript>
  <p class="notice error">
    Enable JavaScript, then reload to use this tool. You can still copy any
    source text before reloading.
  </p>
</noscript>
<script is:inline>
  (() => {
    const notice = document.getElementById("utility-startup");
    notice.textContent =
      "Loading tool controls. You can paste or type source now; your text stays in this browser.";
    let ready = false;
    document.querySelectorAll(".utility-app button").forEach((button) => {
      if (!button.disabled) {
        button.dataset.startupWasEnabled = "true";
        button.disabled = true;
      }
    });
    window.addEventListener(
      "utilitypot:ready",
      () => {
        ready = true;
        notice.hidden = true;
        document
          .querySelectorAll(
            '.utility-app button[data-startup-was-enabled="true"]',
          )
          .forEach((button) => {
            button.disabled = false;
            delete button.dataset.startupWasEnabled;
          });
      },
      { once: true },
    );
    const failed = () => {
      if (ready) return;
      notice.textContent =
        "Tool controls did not finish loading. Your text is still here and can be copied. Check your connection, then reload this page to try again.";
      notice.classList.add("error");
    };
    window.addEventListener("error", (event) => {
      if (event.filename?.includes(".js")) failed();
    });
    window.addEventListener("unhandledrejection", failed);
    setTimeout(failed, 12000);
  })();
</script>
<script>
  import "../scripts/extra-utilities.js";
</script>
