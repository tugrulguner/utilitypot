---
import FamilyDiscovery from "../components/FamilyDiscovery.astro";
import tools from "../data/tools.json";
import "@fontsource-variable/manrope";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/global.css";
import "../styles/utilities.css";
import { posthogScript } from "../lib/analytics.js";
import "../styles/family.css";
import "../styles/workspaces.css";
interface Props {
  title: string;
  searchTitle?: string;
  seoDescription?: string;
  description: string;
  slug: string;
  canonicalPath?: string;
  overview?: boolean;
}
const { title, description, slug } = Astro.props;
const seoDescription = Astro.props.seoDescription ?? description;
const searchTitle = Astro.props.searchTitle ?? title;
const canonical = `https://utilitypot.modepot.io${Astro.props.canonicalPath ?? "/" + (slug ? "tools/" + slug + "/" : "")}`;
const toolName =
  tools.find((tool) => tool.slug === slug)?.title ?? "UtilityPot";
const issueUrl = `https://github.com/tugrulguner/utilitypot/issues/new?title=${encodeURIComponent(`[${toolName}] Feedback`)}&body=${encodeURIComponent(`Tool: ${toolName}\nPage: ${canonical.replace(/[?#].*$/, "")}\n\nPlease avoid including private data.`)}`;
const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: title,
  description: seoDescription,
  url: canonical,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Web browser",
  isAccessibleForFree: true,
  license: "https://opensource.org/license/mit",
  codeRepository: "https://github.com/tugrulguner/utilitypot",
  isPartOf: { "@type": "WebSite", name: "ModePot", url: "https://modepot.io/" },
  creator: {
    "@type": "Person",
    name: "Tugrul Guner",
    url: "https://tugrul.modepot.io/",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{searchTitle} | UtilityPot</title>
    <meta name="description" content={seoDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/utilitypot-mark-v2.svg?v=public-positioning-2" />
    <script is:inline>
      (() => {
        let preference = "auto";
        try {
          preference = localStorage.getItem("utilitypot-theme") || "auto";
        } catch {}
        if (!["auto", "light", "dark"].includes(preference))
          preference = "auto";
        document.documentElement.dataset.theme =
          preference === "auto"
            ? matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : preference;
      })();
    </script>
    <meta property="og:title" content={`${searchTitle} | UtilityPot`} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content="https://utilitypot.modepot.io/utilitypot-social-v2.png?v=public-positioning-2"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:image"
      content="https://utilitypot.modepot.io/utilitypot-social-v2.png?v=public-positioning-2"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <link rel="alternate" type="text/plain" href="/llms.txt" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          schema,
          {
            "@type": "WebSite",
            name: "UtilityPot",
            url: "https://utilitypot.modepot.io/",
            isPartOf: {
              "@type": "WebSite",
              name: "ModePot",
              url: "https://modepot.io/",
            },
          },
        ],
      })}
    />
    <script is:inline set:html={posthogScript} />
  </head>
  <body class="utility-page">
    <a href="#main" class="skip-link">
      Skip to tool
    </a>
    <header class="utility-header" data-discovery-surface="header">
      <a class="brand" href="/">
        <img
          src="/utilitypot-mark-v2.svg?v=public-positioning-2"
          alt=""
          width="32"
          height="32"
        />
        <span>
          utility<strong>pot</strong>
        </span>
      </a>
      <nav class="family-nav" aria-label="Main">
        <a
          href="https://modepot.io/"
          class="ph-no-autocapture"
          data-discovery-destination="modepot"
        >
          ModePot
        </a>
        <a href="https://github.com/tugrulguner/utilitypot">GitHub</a>
        <a
          href="https://www.linkedin.com/in/tugrulguner/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn (opens in a new tab)"
        >
          LinkedIn
        </a>
        <a
          href="https://x.com/Tugrul_Guner"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="X (opens in a new tab)"
        >
          X
        </a>
        <a href="https://discord.gg/u3AANZr6RG">Community</a>
        <a
          href="https://tugrul.modepot.io/"
          class="ph-no-autocapture"
          data-discovery-destination="creator"
        >
          About Tugrul
        </a>
      </nav>
      <select id="color-theme" aria-label="Color theme">
        <option value="auto">Auto</option>
        <option value="light">Light</option>
        <option value="dark">Dark</option>
      </select>
      <button
        id="family-menu-toggle"
        type="button"
        aria-controls="family-menu"
        aria-expanded="false"
      >
        Menu
      </button>
      <nav id="family-menu" aria-label="Compact navigation" hidden>
        <a
          href="https://modepot.io/"
          class="ph-no-autocapture"
          data-discovery-destination="modepot"
        >
          ModePot
        </a>
        <a href="https://github.com/tugrulguner/utilitypot">GitHub</a>
        <a
          href="https://www.linkedin.com/in/tugrulguner/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn (opens in a new tab)"
        >
          LinkedIn
        </a>
        <a
          href="https://x.com/Tugrul_Guner"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="X (opens in a new tab)"
        >
          X
        </a>
        <a href="https://discord.gg/u3AANZr6RG">Community</a>
        <a
          href="https://tugrul.modepot.io/"
          class="ph-no-autocapture"
          data-discovery-destination="creator"
        >
          About Tugrul
        </a>
        <a href="/#tools">Browse tools</a>
        <a href="/privacy/">Privacy &amp; limits</a>
      </nav>
    </header>
    <main id="main" class="utility-main">
      {!Astro.props.overview && (
        <>
          {tools.some((tool) => tool.slug === slug) ? (
            <FamilyDiscovery surface="intro" />
          ) : (
            <p class="coordinate">UTILITYPOT / PART OF MODEPOT</p>
          )}
          <h1>{title}</h1>
          <p class="utility-intro">{description}</p>
        </>
      )}
      <slot />
      <p class="feedback-link">
        <a
          href={issueUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="ph-no-autocapture"
        >
          Feedback / issue for {toolName} ↗
        </a>{" "}
        <span>GitHub opens in a new tab. Avoid private data.</span>
      </p>
    </main>
    <footer class="utility-footer" data-discovery-surface="footer">
      <p>
        Small tools. Inspectable results.{" "}
        <a
          href="https://modepot.io/"
          class="ph-no-autocapture"
          data-discovery-destination="modepot"
        >
          Explore the ModePot family →
        </a>
      </p>
      <p>
        Created by{" "}
        <a
          href="https://tugrul.modepot.io/"
          class="ph-no-autocapture"
          data-discovery-destination="creator"
        >
          Tugrul Guner
        </a>{" "}
        · <a href="/">Free tools</a> · <a href="/privacy/">Privacy & limits</a>
      </p>
      <p>
        <a
          href="https://github.com/tugrulguner/utilitypot/issues/new?title=UtilityPot%20feedback&body=Page%3A%20https%3A%2F%2Futilitypot.modepot.io%2F%20%0A%0APlease%20avoid%20including%20private%20data."
          target="_blank"
          rel="noopener noreferrer"
          class="ph-no-autocapture"
        >
          UtilityPot site feedback / issue ↗
        </a>{" "}
        <span>GitHub opens in a new tab. Avoid private data.</span>
      </p>
      <p class="next-link">
        <a href="/#tools">Next — Browse tools →</a>
      </p>
    </footer>
    <script>
      import "../scripts/family-shell.js";
      import "../scripts/discovery.js";
    </script>
  </body>
</html>
