{
  "name": "utilitypot",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build && node scripts/verify-site.mjs && node scripts/verify-discovery-site.mjs",
    "test": "node --test src/lib/*.test.mjs src/lib/utilities/*.test.mjs",
    "preview": "astro preview",
    "test:browser": "playwright test",
    "test:worker": "playwright test --config=playwright.utilities.config.mjs",
    "deploy": "npm run build && wrangler deploy",
    "test:release": "node --test scripts/*.test.mjs",
    "format:check": "prettier --check .",
    "release:bundle": "node scripts/release.mjs bundle",
    "test:release-artifact": "playwright test --config=playwright.artifact.config.mjs",
    "test:live": "node scripts/live-product-qa.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "astro": "^7.3.5",
    "cron-parser": "5.10.2",
    "htmlparser2": "^12.0.0",
    "ipaddr.js": "2.5.0",
    "mermaid": "^12.2.0",
    "papaparse": "^5.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/papaparse": "^5.5.2",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.142.0",
    "yaml": "^2.9.1"
  }
}
