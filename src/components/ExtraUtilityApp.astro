---
interface Props {
  tool: "jsonCsv" | "entities" | "diagram" | "qa";
}
const { tool } = Astro.props;
---

<section data-extra-utility={tool} class="ph-no-capture ph-no-autocapture">
  <div class="actions">
    <button id="extra-example">Load example</button>
  </div>
  {tool === "qa" && (
    <div class="panel">
      <label for="page-url">Public documentation URL (optional)</label>
      <input
        id="page-url"
        type="url"
        maxlength="2000"
        placeholder="https://docs.python.org/3/library/json.html"
      />
      <div class="actions">
        <button id="read-page">Read public page</button>
      </div>
      <p class="notice">
        URL reading is limited to docs.python.org, developer.mozilla.org,
        docs.typesafe.ai, mermaid.js.org, developers.cloudflare.com,
        www.rfc-editor.org and en.wikipedia.org. Other pages: paste their text
        below. This fetch sends the URL to our server, not to Jev, and executes
        no page scripts. Login/paywall bypass is not supported.
      </p>
    </div>
  )}
  <div class="utility-grid">
    <div class="panel">
      <label for="source-text">
        {tool === "jsonCsv"
          ? "JSON document"
          : tool === "diagram"
            ? "Process steps (one per line)"
            : tool === "qa"
              ? "Page text"
              : "Shared text"}
      </label>
      <textarea
        id="source-text"
        rows="10"
        spellcheck="false"
        maxlength={
          tool === "jsonCsv"
            ? 2000000
            : tool === "qa"
              ? 10000
              : tool === "diagram"
                ? 1800
                : 5000
        }
      />
      <p class="notice">
        {tool === "entities"
          ? "Up to 120 source tokens. Each defined category returns at most three mentions; this is not exhaustive full-document NER."
          : tool === "diagram"
            ? "Up to eight short steps. Jev selects node roles and supported relationships; it does not write Mermaid code."
            : tool === "qa"
              ? "Up to 10,000 characters and 100 paragraphs. Answers are exact excerpts, not generated explanations. A fetched page may be truncated; inspect the text before asking."
              : "Arrays of objects, up to 10,000 rows. Identifiers stay textual. No arbitrary scripts."}
      </p>
    </div>
    <div class="panel">
      <label for="instructions">
        {tool === "entities"
          ? "Entity definitions (Type: definition per line)"
          : tool === "qa"
            ? "Question"
            : "Describe the desired result"}
      </label>
      <textarea
        id="instructions"
        rows="5"
        maxlength={tool === "entities" ? 1000 : tool === "qa" ? 400 : 800}
      />
      {tool === "jsonCsv" && (
        <>
          <label for="row-path">Record array</label>
          <select id="row-path">
            <option value="">Prepare arrays first</option>
          </select>
          <label for="array-policy">Other nested arrays</label>
          <select id="array-policy">
            <option value="reject">Reject until explicitly resolved</option>
            <option value="omit">Omit nested-array fields</option>
            <option value="join">Store arrays as JSON-text cells</option>
          </select>
          <div class="actions">
            <button id="prepare-extra">Find record arrays locally</button>
          </div>
        </>
      )}
      {tool === "diagram" && (
        <div class="actions">
          <button id="prepare-extra">Prepare a sequential graph locally</button>
        </div>
      )}
      <p class="notice">
        {tool === "entities"
          ? "Define 1–4 categories. Jev selects exact start/end tokens in the source. Missing or inconsistent spans are rejected; review the proposals before export."
          : tool === "qa"
            ? "Jev checks whether the source contains an answer and selects a supporting paragraph. A source can be wrong or malicious; excerpts are evidence from that source, not independent fact verification."
            : "Manual controls remain available without Jev. Review proposals before converting or rendering."}
      </p>
    </div>
  </div>
  <div class="panel">
    <h2>Jev interpretation</h2>
    <p class="notice">
      {tool === "jsonCsv"
        ? "AI receives a reduced JSON sample (at most five items per array) and your instructions."
        : tool === "diagram"
          ? "AI receives the listed steps and relationship instructions."
          : tool === "entities"
            ? "AI receives the entire bounded text and your category definitions."
            : "AI receives the bounded page text and your question. No external knowledge is used to construct an answer."}{" "}
      Your inputs are not stored by this application or sent to analytics.
      TypeSafe receives submitted AI context.
    </p>
    <label class="check">
      <input id="extra-consent" type="checkbox" />I agree to send this context
      to Jev.
    </label>
    <div class="actions">
      <button id="extra-ask">Ask Jev</button>
    </div>
  </div>
  {(tool === "entities" || tool === "diagram") && (
    <div class="panel">
      <label for="review-plan">
        Editable {tool === "diagram" ? "graph" : "entity"} JSON
      </label>
      <textarea
        id="review-plan"
        rows="7"
        spellcheck="false"
        maxlength="20000"
      />
      <label class="check">
        <input id="extra-reviewed" type="checkbox" />I reviewed this proposal
        against my source.
      </label>
      <div class="actions">
        <button id="extra-run" class="primary">
          {tool === "diagram"
            ? "Render Mermaid locally"
            : "Validate and export entities"}
        </button>
      </div>
    </div>
  )}
  {tool === "jsonCsv" && (
    <>
      <label class="check">
        <input id="extra-reviewed" type="checkbox" />I reviewed the selected
        record array and nested-array policy.
      </label>
      <div class="actions">
        <button id="extra-run" class="primary">
          Convert JSON to CSV locally
        </button>
      </div>
    </>
  )}
  <p id="extra-status" class="utility-status" role="status" aria-live="polite">
    Load an example or enter your source.
  </p>
  <section id="extra-results" class="panel" hidden>
    <h2>Result</h2>
    <div id="extra-visual" />
    <pre id="extra-output" />
    <div class="actions">
      <button id="extra-download">Download result</button>
      <button id="extra-copy">Copy result</button>
    </div>
  </section>
</section>
<script>
  import "../scripts/extra-utilities.js";
</script>
