---
import { guides, projects } from "../data/discovery.js";
import tools from "../data/tools.json";
import WorkshopProject from "./WorkshopProject.astro";
interface Props {
  slug: keyof typeof guides;
}
const { slug } = Astro.props;
const guide = guides[slug];
const project = projects[guide.project as keyof typeof projects];
---

<aside
  class="discovery-rail"
  data-discovery-surface="showcase"
  aria-label="Explore ModePot projects"
>
  <section class="family-card" aria-label="ModePot and its creator">
    <a
      class="discovery-brand ph-no-autocapture"
      href="https://modepot.io/"
      data-discovery-destination="modepot"
      aria-label="ModePot open-source family"
    >
      <img
        src="/modepot-mark.svg?v=multicolour-1"
        width="36"
        height="36"
        alt=""
      />
      <span>
        mode<strong>pot</strong>
      </span>
    </a>
    <p>Tools and projects by Tugrul Guner.</p>
    <nav class="discovery-actions" aria-label="ModePot and creator links">
      <a
        class="discovery-cta ph-no-autocapture"
        href="https://modepot.io/"
        data-discovery-destination="modepot"
      >
        Explore ModePot
      </a>
      <a
        class="discovery-cta ph-no-autocapture"
        href="https://tugrul.modepot.io/"
        data-discovery-destination="creator"
      >
        About Tugrul
      </a>
    </nav>
  </section>
  <section
    class="tool-discovery"
    data-project-showcase
    aria-label="Explore a ModePot project"
  >
    <h2>From the ModePot workshop</h2>
    <div data-workshop-content>
      <WorkshopProject project={project} id={guide.project} />
    </div>
    {Object.entries(projects).map(([id, project]) => (
      <template data-workshop-option data-project-id={id}>
        <WorkshopProject project={project} id={id} />
      </template>
    ))}
  </section>
</aside>
<script>
  import "../scripts/workshop-discovery.js";
</script>
<section class="prose tool-guide" aria-label="How to use this tool">
  <h2>Try it, review it, reuse it</h2>
  <ol>
    {guide.steps.map((step) => (
      <li>{step}</li>
    ))}
  </ol>
  <p>
    <strong>Example:</strong> {guide.example}
  </p>
  <nav data-related-tools aria-label="Related tools">
    <h3>Useful next tools</h3>
    <ul>
      {guide.related.map((slug) => {
        const tool = tools.find((tool) => tool.slug === slug)!;
        return (
          <li>
            <a class="ph-no-autocapture" href={`/tools/${slug}/`}>
              {tool.title}
            </a>{" "}
            — {tool.description}
          </li>
        );
      })}
    </ul>
  </nav>
  <p>
    Keep this page bookmarked for your next task. Inputs are not saved for
    return visits.
  </p>
</section>
